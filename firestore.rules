rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
      // nightly backup: read-only access to everyone's saved words and notes
    match /users/{uid}/data/{doc} {
      allow read: if request.auth != null && request.auth.uid == "H1fbG8NKAhTbIVZhmidfT6tfpNN2";
    }
  match /dms/{tid} {
  allow read: if request.auth != null
    && (resource == null || request.auth.uid in resource.data.members);
  allow create, update: if request.auth != null
    && request.auth.uid in request.resource.data.members
    && request.resource.data.members.size() == 2
    && tid == request.resource.data.members[0] + '_' + request.resource.data.members[1];
  allow delete: if false;

  match /msgs/{mid} {
    allow read: if request.auth != null && request.auth.uid in tid.split('_');
    allow create: if request.auth != null
      && request.auth.uid in tid.split('_')
      && request.resource.data.from == request.auth.uid;
    allow update, delete: if false;
  }
}
  match /dms/{tid} {
  allow read: if request.auth != null && request.auth.uid in resource.data.members;
  allow create: if request.auth != null && (clubIn() || clubNoa())
    && request.auth.uid in request.resource.data.members
    && request.resource.data.members.size() == 2
    && tid == request.resource.data.members[0] + "_" + request.resource.data.members[1];
  allow update: if request.auth != null && request.auth.uid in resource.data.members
    && request.resource.data.members == resource.data.members;
  match /msgs/{mid} {
    allow read: if request.auth != null && request.auth.uid in get(/databases/$(database)/documents/dms/$(tid)).data.members;
    allow create: if request.auth != null && request.resource.data.from == request.auth.uid
      && request.auth.uid in get(/databases/$(database)/documents/dms/$(tid)).data.members;
    allow delete: if request.auth != null && resource.data.from == request.auth.uid;
  }
}
      // Hibi is invite-only: anyone can ask for access, only Noa approves
    match /accessRequests/{id} {
      allow create: if request.resource.data.keys().hasOnly(['name','email','who','msg','at'])
        && request.resource.data.name is string && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 80
        && request.resource.data.email is string && request.resource.data.email.matches('.+@.+[.].+') && request.resource.data.email.size() <= 120
        && request.resource.data.who is string && request.resource.data.who.size() <= 20
        && request.resource.data.msg is string && request.resource.data.msg.size() <= 500
        && request.resource.data.at is int;
      allow read, delete: if clubNoa() || clubBot();
    }
    match /access/{email} {
      allow get: if request.auth != null && (request.auth.token.email.lower() == email || clubNoa() || clubBot());
      allow list, write: if clubNoa() || clubBot();
    }
      // Hibi club extras: bell, profiles, polls & RSVPs, reports, streaks
    function clubIn() { return request.auth != null && (request.auth.uid == "J8D2tjQmBaaA2QN730tSfSrjfm73" || exists(/databases/$(database)/documents/clubAccess/$(request.auth.uid))); }
    function clubNoa() { return request.auth != null && request.auth.uid == "J8D2tjQmBaaA2QN730tSfSrjfm73"; }
    function clubBot() { return request.auth != null && request.auth.token.email == "nightly-helper@learnwithnoa-cheatsheet.firebaseapp.com"; }
    match /clubNotes/{id} {
      allow create: if clubIn() && request.resource.data.uid == request.auth.uid;
      allow read, delete: if request.auth != null && (resource.data.to == request.auth.uid || clubNoa());
    }
    match /clubProfiles/{uid} {
      allow read: if clubIn() || clubBot();
      allow write: if (clubIn() && request.auth.uid == uid) || clubNoa() || clubBot();
    }
    match /clubVotes/{id} {
      allow read: if clubIn() || clubBot();
      allow create, update: if clubIn() && request.resource.data.uid == request.auth.uid && id.matches('.*_' + request.auth.uid);
      allow delete: if clubIn() && resource.data.uid == request.auth.uid;
    }
    match /clubReports/{id} {
      allow create: if clubIn() && request.resource.data.uid == request.auth.uid;
      allow read, delete: if clubNoa() || clubBot();
    }
    match /clubStats/{uid} {
      allow read: if clubIn() || clubBot();
      allow write: if clubNoa() || clubBot();
    }
      // ===== Hibi club community (added Nov 2026) =====
          match /clubPublic/{doc} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && (request.auth.uid == "J8D2tjQmBaaA2QN730tSfSrjfm73" || request.auth.token.email == "nightly-helper@learnwithnoa-cheatsheet.firebaseapp.com");
    }
    function hbTeacher() { return request.auth != null && request.auth.uid == "J8D2tjQmBaaA2QN730tSfSrjfm73"; }
    function hbHelper() { return request.auth != null && request.auth.token.email == "nightly-helper@learnwithnoa-cheatsheet.firebaseapp.com"; }
    function hbMember() { return request.auth != null && (hbTeacher() || exists(/databases/$(database)/documents/clubAccess/$(request.auth.uid))); }
    function hbOwnNew() { return request.resource.data.uid == request.auth.uid && request.resource.data.json is string && request.resource.data.json.size() < 20000; }
    match /clubAccess/{uid} {
      allow read: if request.auth != null && (request.auth.uid == uid || hbTeacher() || hbHelper());
      allow write: if hbTeacher() || hbHelper();
    }
    match /clubPosts/{postId} {
      allow read: if hbMember() || hbHelper();
      allow create: if hbMember() && hbOwnNew();
      allow update: if hbMember() && ((resource.data.uid == request.auth.uid && request.resource.data.uid == request.auth.uid) || request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likes', 'n', 'lastAt']));
      allow delete: if hbTeacher() || (hbMember() && resource.data.uid == request.auth.uid);
      match /comments/{cid} {
        allow read: if hbMember() || hbHelper();
        allow create: if hbMember() && hbOwnNew();
        allow update: if hbMember() && ((resource.data.uid == request.auth.uid && request.resource.data.uid == request.auth.uid) || request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likes']));
        allow delete: if hbTeacher() || (hbMember() && resource.data.uid == request.auth.uid);
      }
    }
    match /clubImgs/{imgId} {
      allow read: if hbMember() || hbHelper();
      allow create: if hbMember() && request.resource.data.uid == request.auth.uid && request.resource.data.data is string && request.resource.data.data.size() < 950000;
      allow delete: if hbTeacher() || (hbMember() && resource.data.uid == request.auth.uid);
    }
    match /clubActivity/{aid} {
      allow read: if hbTeacher() || hbHelper();
      allow create: if hbMember() && request.resource.data.uid == request.auth.uid;
      allow delete: if hbTeacher();
    }
    function isTeacher() {
      return request.auth != null
        && request.auth.token.email == "learnwithnoa@gmail.com"
        && request.auth.token.email_verified == true;
    }
    function isHelper() {
      return request.auth != null
        && request.auth.token.email == "nightly-helper@learnwithnoa-cheatsheet.firebaseapp.com";
    }

    // each student's own data
    match /users/{uid}/{rest=**} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
      allow read: if isHelper();
    }

    // teacher view: read everyone, edit words and notes
    match /users/{rest=**} {
      allow read: if isTeacher();
    }
    match /users/{uid}/data/{key} {
      allow write: if isTeacher();
    }

    // nightly helper: can only touch the student hub data
    match /users/{uid}/data/{key} {
      allow read, write: if isHelper()
        && (key.matches("t-hub-.*") || key == "t-hubmeta" || key == "hub-view");
    }

    // Buddy park: everyone signed in can see the buddies
    match /park/{uid} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && (request.auth.uid == uid || isTeacher());
    }

    // love sent in the park: one per person per buddy per day
    match /park/{uid}/hearts/{hid} {
      allow create: if request.auth != null && request.auth.uid != uid
        && request.resource.data.from == request.auth.uid
        && hid.matches(request.auth.uid + '_.*');
      allow read, delete: if request.auth != null && request.auth.uid == uid;
    }

    // club / private / hidden: only you (and the nightly helper, for linking) can set it
    match /roles/{uid} {
      allow read: if request.auth != null;
      allow write: if isTeacher() || isHelper();
    }

    // messages from Noa: only you can send, only the student can read and clear them
    match /inbox/{uid}/msgs/{mid} {
      allow create: if isTeacher();
      allow read, delete: if request.auth != null && request.auth.uid == uid;
    }
  }
}